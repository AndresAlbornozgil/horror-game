# Postgres connection string (persistent data only)
DATABASE_URL="postgresql://USER@HOST/DATABASE"

# URL the browser uses to reach the Socket.IO server
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# Socket.IO server
SOCKET_PORT=4000
# Origin allowed by the Socket.IO server's CORS policy (the Next.js app)
CLIENT_ORIGIN="http://localhost:3000"
